{
  "name": "xrift-avatar-anchor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Adjustable head anchors and overhead status experiments",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./xrift": {
      "types": "./src/adapters/xrift.d.mts",
      "import": "./src/adapters/xrift.mjs"
    },
    "./vrm": {
      "types": "./src/adapters/vrm.d.mts",
      "import": "./src/adapters/vrm.mjs"
    },
    "./overhead": {
      "types": "./src/overhead.d.mts",
      "import": "./src/overhead.mjs"
    },
    "./xrift-runtime": {
      "types": "./src/adapters/xrift-runtime.d.mts",
      "import": "./src/adapters/xrift-runtime.mjs"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5227 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "experiment": "node scripts/run-experiments.mjs",
    "item:dev": "npm --prefix item/overhead-tag run dev",
    "item:build": "npm --prefix item/overhead-tag run build",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "verify": "npm test && npm run build"
  },
  "peerDependencies": {
    "three": ">=0.183.1 <0.184.0"
  },
  "devDependencies": {
    "three": "0.183.1",
    "@types/three": "0.183.1",
    "@pixiv/three-vrm": "3.5.5",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
